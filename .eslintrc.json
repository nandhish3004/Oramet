{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "env": {
    "es2021": true,
    "node": true,
    "jest": true
  },
  "rules": {
    "no-constant-condition": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "error",
    "valid-typeof": "error"
  }
}
