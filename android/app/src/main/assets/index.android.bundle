:'\u0928\u0926\u0940\u091a\u0940 \u092a\u093e\u0924\u0933\u0940',imdRadarCategory:'\u0939\u0935\u093e\u092e\u093e\u0928 \u0935\u093f\u092d\u093e\u0917 \u0930\u0921\u093e\u0930',nasaCategory:'\u0928\u093e\u0938\u093e \u090f\u0938\u090f\u092e\u090f\u092a\u0940 \u0909\u092a\u0917\u094d\u0930\u0939',gsiCategory:'\u091c\u0940\u090f\u0938\u0906\u092f \u0926\u0930\u0921 \u0938\u0930\u094d\u0935\u0947\u0915\u094d\u0937\u0923',cwcCategory:'\u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u091c\u0932 \u0906\u092f\u094b\u0917',dryClear:'\u0915\u094b\u0930\u0921\u0947 \u0906\u0923\u093f \u0938\u094d\u0935\u091a\u094d\u091b',lightRain:'\u0939\u0932\u0915\u093e \u092a\u093e\u090a\u0938',heavyRain:'\u092e\u0941\u0938\u0933\u0927\u093e\u0930 \u092a\u093e\u090a\u0938',dryBed:'\u0915\u094b\u0930\u0921\u0940 \u091c\u092e\u0940\u0928',safeMoisture:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0913\u0932\u093e\u0935\u093e',saturatedSoil:'\u092e\u093e\u0924\u0940 \u092a\u093e\u0923\u094d\u092f\u093e\u0928\u0947 \u092d\u0930\u0932\u0947\u0932\u0940',stableSlope:'\u0938\u094d\u0925\u093f\u0930 \u0909\u0924\u093e\u0930 Fs 1.48',safeRiverFlow:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u094d\u0930\u0935\u093e\u0939',currentWeatherDetails:'\u0938\u0927\u094d\u092f\u093e\u091a\u0947 \u0939\u0935\u093e\u092e\u093e\u0928',tapToInspectHint:'\u0924\u092a\u0936\u0940\u0932\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u0930\u094d\u0921\u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e',precipitationLabel:'\u092a\u093e\u0935\u0938\u093e\u091a\u0947 \u092a\u094d\u0930\u092e\u093e\u0923',humidityLabel:'\u0939\u0935\u0947\u0924\u0940\u0932 \u0906\u0930\u094d\u0926\u094d\u0930\u0924\u093e',windSpeedLabel:'\u0935\u093e\u0931\u094d\u092f\u093e\u091a\u093e \u0935\u0947\u0917',pressureLabel:'\u0939\u0935\u0947\u091a\u093e \u0926\u093e\u092c',fiveDayForecast:'\u092a\u0941\u0922\u0940\u0932 5 \u0926\u093f\u0935\u0938\u093e\u0902\u091a\u093e \u0905\u0902\u0926\u093e\u091c',tapDayForOutlook:'\u