2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 240 \u0bae\u0bc0\u0b9f\u0bcd\u0b9f\u0bb0\u0bcd \u0b89\u0baf\u0bb0\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bbe\u0bb1\u0bc8\u0baa\u0bcd\u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b85\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bbe\u0ba9\u0bcd\u0b95\u0bbf\u0bb0\u0bc0\u0b9f\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0b9f\u0bae\u0bcd. \u0b9a\u0bc2\u0bb0\u0bbf\u0baf \u0bae\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd, \u0b95\u0bc1\u0b9f\u0bbf\u0ba8\u0bc0\u0bb0\u0bcd, \u0bae\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0b9a\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba9.',alternativeShelters:'\u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bcd\u0b95\u0bb3\u0bcd',govtCollege:'\u0b85\u0bb0\u0b9a\u0bc1 \u0bae\u0bc7\u0bb2\u0bcd\u0ba8\u0bbf\u0bb2\u0bc8\u0baa\u0bcd \u0baa\u0bb3\u0bcd\u0bb3\u0bbf',panchayatBhawan:'\u0b8a\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0bae\u0ba9\u0bcd\u0bb1\u0bae\u0bcd',primarySchool:'\u0ba4\u0bca\u0b9f\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0bb3\u0bcd\u0bb3\u0bbf',highRidge:'\u0bae\u0bc7\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0ba4\u0bbf\u0b9f\u0bb2\u0bcd',startNavigation:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0bb5\u0bb4\u0bbf\u0baf\u0bc8\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba4\u0bca\u0b9f\u0bb0\u0bb5\u0bc1\u0bae\u0bcd',uphillDirections:'\u0bb5\u0bb4\u0bbf\u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf \u203a',shelterWalkTime:'\u0b9a\u0bae\u0bc2\u0b95 \u0ba8\u0bb2\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bae\u0bcd \xb7 ~15 \u0ba8\u0bbf\u0bae\u0bbf\u0b9f\u0bae\u0bcd \u0bae\u0bc7\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0ba8\u0b9f\u0bc8',liveSummary:'\u0ba8\u0bc7\u0bb0\u0bb2\u0bc8 \u0bb0\u0bc7\u0b9f\u0bbe\u0bb0\u0bcd \u0b9a\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bae\u0bcd',currentStatus:'\u0ba4\u0bb1\u0bcd\u0baa\u0bcb\u0ba4\u0bc8\u0baf \u0b85\u0baa\u0bbe\u0baf \u0ba8\u0bbf\u0bb2\u0bc8',normalSafe:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9\u0ba4\u0bc1 / \u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1',waterLevelLabel:'\u0b86\u0bb1\u0bcd\u0bb1\u0bc1 \u0ba8\u0bc0\u0bb0\u0bcd\u0bae\u0b9f\u0bcd\u0b9f\u0bae\u0bcd',waterLevelVal:'1,150.2 \u0bae\u0bc0 (\u0b87\u0baf\u0bb2\u0bcd\u0baa\u0bc1)',evacLeadTimeLabel:'\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0b95\u0bbe\u0b9a\u0bae\u0bcd',evacLeadTimeVal:'35 \u0ba8\u0bbf\u0bae\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1',dispatchSosBtn:'NDRF \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0bbf\u0b95\u0bbe\u0bb0\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 SOS \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0b95',dialectNameNotice:'\u0ba8\u0bc0\u0bb2\u0b95\u0bbf\u0bb0\u0bbf \u0bae\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b95\u0bc1\u0ba4\u0bbf \u0baa\u0baf\u0ba9\u0bcd\u0bae\u0bc1\u0bb1\u0bc8'},kn:{appName:'\u0c92\u0cb0\u0cae\u0cc6\u0c9f\u0ccd (OraMet)',appSubtitle:'\u0cae\u0cbf\u0c82\u0c9a\u0cbf\u0ca8 \u0caa\u0ccd\u0cb0\u0cb5\u0cbe\u0cb9 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cad\u0cc2\u0c95\u0cc1\u0cb8\u0cbf\u0ca4 \u0cae\u0cc1\u0ca8\u0ccd\u0ca8\u0cc6\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6',liveWatchHeader:'\u0cb2\u0cc8\u0cb5\u0ccd \u0caa\u0ccd\u0cb0\u0cb5\u0cbe\u0cb9 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cb5\u0cbe\u0cae\u0cbe\u0ca8 \u0c95\u0ca3\u0ccd\u0c97\u0cbe\u0cb5\u0cb2\u0cc1',liveSatelliteWatch:'\u0cb2\u0cc8\u0cb5\u0ccd \u0c89\u0caa\u0c97\u0ccd\u0cb0\u0cb9 \u0c95\u0ca3\u0ccd\u0c97\u0cbe\u0cb5\u0cb2\u0cc1',criticalEvacWindow:'\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3\u0cbe\u0c82\u0ca4\u0cb0 \u0cb8\u0cae\u0caf',liveSurgeLeadTime:'\u0caa\u0ccd\u0cb0\u0cb5\u0cbe\u0cb9 \u0c8f\u0cb0\u0cbf\u0c95\u0cc6\u0caf \u0c95\u0cbe\u0cb2\u0cbe\u0cb5\u0ca7\u0cbf',minutesRemaining:'\u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3\u0cc1',surgeAdvisory:'\u0ca8\u0ca6\u0cbf \u0ca8\u0cc0\u0cb0\u0cbf\u0ca8 \u0cae\u0c9f\u0ccd\u0c9f \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbe\u0c97\u0cc1\u0cb5 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0ca4\u0cc6\u0caf\u0cbf\u0ca6\u0cc6. \u0cac\u0cc6\u0c9f\u0ccd\u0c9f\u0ca6 \u0c8e\u0ca4\u0ccd\u0ca4\u0cb0\u0ca6 \u0cb0\u0cb8\u0ccd\u0ca4\u0cc6\u0c97\u0cb3\u0cc1 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb5\u0cc6.',viewSafeHavens:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0c86\u0cb6\u0ccd\u0cb0\u0caf \u0ca8\u0ccb\u0ca1\u0cbf \u203a',googleMobileLogin:'\u0c97\u0cc2\u0c97\u0cb2\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd',loginVerified:'\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0ca4 \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95',searchPlaceholder:'\u0c86\u0cb6\u0ccd\u0cb0\u0caf \u0ca4\u0cbe\u0ca3, \u0cae\u0cb3\u0cc6 \u0cb0\u0cc7\u0ca1\u0cbe\u0cb0\u0ccd, 112 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf...',safetyEssentials:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cbe \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0ca4\u0cc6\u0c97\u0cb3\u0cc1',viewAll:'\u0c8e\u0cb2\u0ccd\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc2 \u0ca8\u0ccb\u0ca1\u0cbf \u203a',allFeeds:'\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb0\u0cc7\u0ca1\u0cbe\u0cb0\u0ccd (4)',rainfallChip:'\u0cae\u0cb3\u0cc6\u0caf \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3',soilChip:'\u0cae\u0ca3\u0ccd\u0ca3\u0cbf\u0ca8 \u0ca4\u0cc7\u0cb5\u0cbe\u0c82\u0cb6',hillSlopeChip:'\u0cac\u0cc6\u0c9f\u0ccd\u0c9f\u0ca6 \u0c87\u0cb3\u0cbf\u0c9c\u0cbe\u0cb0\u0cc1',riverStageChip:'\u0ca8\u0ca6\u0cbf \u0ca8\u0cc0\u0cb0\u0cbf\u0ca8 \u0cae\u0c9f\u0ccd\u0c9f',imdRadarCategory:'\u0c90\u0c8e\u0c82\u0ca1\u0cbf \u0cb9\u0cb5\u0cbe\u0cae\u0cbe\u0ca8 \u0cb0\u0cc7\u0ca1\u0cbe\u0cb0\u0ccd',nasaCategory:'\u0ca8\u0cbe\u0cb8\u0cbe \u0c8e\u0cb8\u0ccd\u0c8e\u0c82\u0c8e\u0caa\u0cbf \u0c89\u0caa\u0c97\u0ccd\u0cb0\u0cb9',gsiCategory:'\u0c9c\u0cbf\u0c8e\u0cb8\u0ccd\u200c\u0c90 \u0cad\u0cc2\u0c95\u0cc1\u0cb8\u0cbf\u0ca4 \u0cb8\u0cae\u0cc0\u0c95\u0ccd\u0cb7\u0cc6',cwcCategory:'\u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0 \u0c9c\u0cb2 \u0c86\u0caf\u0ccb\u0c97',dryClear:'\u0cb8\u0ccd\u0cb5\u0c9a\u0ccd\u0c9b \u0cb9\u0cb5\u0cbe\u0cae\u0cbe\u0ca8',lightRain:'\u0cb9\u0c97\u0cc1\u0cb0 \u0cae\u0cb3\u0cc6',heavyRain:'\u0cad\u0cbe\u0cb0\u0cc0 \u0cae\u0cb3\u0cc6',dryBed:'\u0c92\u0ca3 \u0cae\u0cc7\u0cb2\u0ccd\u0cae\u0cc8',safeMoisture:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0ca4\u0cc7\u0cb5\u0cbe\u0c82\u0cb6',saturatedSoil:'\u0c85\u0ca4\u0cbf\u0caf\u0cbe\u0ca6 \u0ca4\u0cc7\u0cb5\u0cbe\u0c82\u0cb6',stableSlope:'\u0cb8\u0ccd\u0ca5\u0cbf\u0cb0 \u0c87\u0cb3\u0cbf\u0c9c\u0cbe\u0cb0\u0cc1 Fs 1.48',safeRiverFlow:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cb9\u0cb0\u0cbf\u0cb5\u0cc1',currentWeatherDetails:'\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb9\u0cb5\u0cbe\u0cae\u0cbe\u0ca8 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1',tapToInspectHint:'\u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0ccd\u0caa\u0cb0\u0ccd\u0cb6\u0cbf\u0cb8\u0cbf',precipitationLabel:'\u0cae\u0cb3\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3',humidityLabel:'\u0ca4\u0cc7\u0cb5\u0cbe\u0c82\u0cb6',windSpeedLabel:'\u0c97\u0cbe\u0cb3\u0cbf\u0caf \u0cb5\u0cc7\u0c97',pressureLabel:'\u0cb5\u0cbe\u0caf\u0cc1\u0cad\u0cbe\u0cb0 \u0c92\u0ca4\u0ccd\u0ca4\u0ca1',fiveDayForecast:'\u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 5 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3 \u0cae\u0cc1\u0ca8\u0ccd\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6',tapDayForOutlook:'\u0ca6\u0cbf\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf',reportHazardTitle:'\u0ca8\u0cc0\u0cb0\u0cc1 \u0ca8\u0cbf\u0cb2\u0ccd\u0cb2\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb0\u0cb8\u0ccd\u0ca4\u0cc6 \u0cb9\u0cbe\u0ca8\u0cbf \u0c95\u0c82\u0ca1\u0cbf\u0ca6\u0cc6\u0caf\u0cc7?',reportHazardSub:'\u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf\u0cb0\u0cbf\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb0\u0c95\u0ccd\u0cb7\u0ca3\u0cbe \u0ca4\u0c82\u0ca1\u0c95\u0ccd\u0c95\u0cc6 \u0ca4\u0c95\u0ccd\u0