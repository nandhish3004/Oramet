etyEssentials:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0b85\u0bae\u0bcd\u0b9a\u0b99\u0bcd\u0b95\u0bb3\u0bcd',viewAll:'\u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u203a',allFeeds:'\u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb0\u0bc7\u0b9f\u0bbe\u0bb0\u0bcd (4)',rainfallChip:'\u0bae\u0bb4\u0bc8 \u0b85\u0bb3\u0bb5\u0bc1',soilChip:'\u0bae\u0ba3\u0bcd \u0b88\u0bb0\u0baa\u0bcd\u0baa\u0ba4\u0bae\u0bcd',hillSlopeChip:'\u0bae\u0bb2\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0bb5\u0bc1',riverStageChip:'\u0b86\u0bb1\u0bcd\u0bb1\u0bc1 \u0ba8\u0bc0\u0bb0\u0bcd\u0bae\u0b9f\u0bcd\u0b9f\u0bae\u0bcd',imdRadarCategory:'\u0b90\u0b8e\u0bae\u0bcd\u0b9f\u0bbf \u0bb5\u0bbe\u0ba9\u0bbf\u0bb2\u0bc8 \u0bb0\u0bc7\u0b9f\u0bbe\u0bb0\u0bcd',nasaCategory:'\u0ba8\u0bbe\u0b9a\u0bbe \u0b8e\u0bb8\u0bcd\u0b8e\u0bae\u0bcd\u0b8f\u0baa\u0bbf \u0b9a\u0bc6\u0baf\u0bb1\u0bcd\u0b95\u0bc8\u0b95\u0bcd\u0b95\u0bcb\u0bb3\u0bcd',gsiCategory:'\u0b9c\u0bbf\u0b8e\u0bb8\u0bcd\u0b90 \u0ba8\u0bbf\u0bb2\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0bb5\u0bc1 \u0b86\u0baf\u0bcd\u0bb5\u0bc1',cwcCategory:'\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0ba8\u0bc0\u0bb0\u0bcd \u0b86\u0ba3\u0bc8\u0baf\u0bae\u0bcd',dryClear:'\u0ba4\u0bc6\u0bb3\u0bbf\u0bb5\u0bbe\u0ba9 \u0bb5\u0bbe\u0ba9\u0bbf\u0bb2\u0bc8',lightRain:'\u0bb2\u0bc7\u0b9a\u0bbe\u0ba9 \u0bae\u0bb4\u0bc8',heavyRain:'\u0b95\u0ba9\u0bae\u0bb4\u0bc8',dryBed:'\u0b89\u0bb2\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0ba4\u0bb0\u0bc8',safeMoisture:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b88\u0bb0\u0baa\u0bcd\u0baa\u0ba4\u0bae\u0bcd',saturatedSoil:'\u0b85\u0ba4\u0bbf\u0b95 \u0b88\u0bb0\u0baa\u0bcd\u0baa\u0ba4\u0bae\u0bcd',stableSlope:'\u0ba8\u0bbf\u0bb2\u0bc8\u0baf\u0bbe\u0ba9 \u0b9a\u0bb0\u0bbf\u0bb5\u0bc1 Fs 1.48',safeRiverFlow:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0ba9 \u0b93\u0b9f\u0bcd\u0b9f\u0bae\u0bcd',currentWeatherDetails:'\u0bb5\u0bbe\u0ba9\u0bbf\u0bb2\u0bc8 \u0bb5\u0b