\u0cb0\u0ca8\u0ccd & \u0cb8\u0cc0\u0c9f\u0cbf',whistleFrequency:'3.5 kHz \u0c85\u0c95\u0ccc\u0cb8\u0ccd\u0c9f\u0cbf\u0c95\u0ccd \u0cb8\u0cc8\u0cb0\u0ca8\u0ccd',zeroNetworkActive:'\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf',soundAction:'\u0caa\u0ccd\u0cb2\u0cc7 \u0cae\u0cbe\u0ca1\u0cbf',changeAction:'\u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf',offlineCbsAlert:'\u0c86\u0cab\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0cc6\u0cb2\u0ccd \u0caa\u0ccd\u0cb0\u0cb8\u0cbe\u0cb0: \u0c87\u0c82\u0c9f\u0cb0\u0ccd\u0ca8\u0cc6\u0c9f\u0ccd \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc2 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c9f\u0cb5\u0cb0\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.',emergencyCallTitle:'\u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0c95\u0cb0\u0cc6',emergencyCallDesc:'112 \u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf \u0cb8\u0cb9\u0cbe\u0caf\u0cb5\u0cbe\u0ca3\u0cbf\u0c97\u0cc6 \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cc6?',cancelBtn:'\u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0cae\u0cbe\u0ca1\u0cbf',call112Btn:'112 \u0c95\u0cb0\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf',smsAlertTitle:'\u0cb8\u0ccd\u0ca5\u0cb3\u0ca6 \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 SMS',smsAlertDesc:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9c\u0cbf\u0caa\u0cbf\u0c8e\u0cb8\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 112 \u0c97\u0cc6 \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 SMS \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc6?',openSmsBtn:'SMS \u0ca4\u0cc6\u0cb0\u0cc6\u0caf\u0cbf\u0cb0\u0cbf',safeHavenDetailsTitle:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0c86\u0cb6\u0ccd\u0cb0\u0caf & \u0c97\u0cc2\u0c97\u0cb2\u0ccd \u0cae\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0cb8\u0ccd',nearestShelter:'\u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0ca6 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0c86\u0cb6\u0ccd\u0cb0\u0caf \u0ca4\u0cbe\u0ca3',distanceKm:'\u0c95\u0cbf.\u0cae\u0cc0 \u0cac\u0cc6\u0c9f\u0ccd\u0c9f\u0ca6 \u0c8e\u0ca4\u0ccd\u0ca4\u0cb0\u0c95\u0ccd\u0c95\u0cc6',verifiedSafeCenter:'\u0caa\u0ccd\u0cb0\u0cbe\u0ca7\u0cbf\u0c95\u0cbe\u0cb0 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0ca4\u0cc6 \u0caa\u0ca1\u0cc6\u0ca6 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cad\u0cb5\u0ca8 (\u0c8e\u0ca4\u0ccd\u0ca4\u0cb0 1,940 \u0cae\u0cc0)',overviewTab:'\u0cb5\u0cbf\u0cb5\u0cb0\u0ca3\u0cc6',routeMapTab:'\u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0ca8\u0c95\u0ccd\u0cb7\u0cc6',facilitiesTab:'\u0cb8\u0ccc\u0cb2\u0cad\u0ccd\u0caf\u0c97\u0cb3\u0cc1',aboutShelter:'\u0c86\u0cb6\u0ccd\u0cb0\u0caf\u0ca6 \u0cac\u0c97\u0ccd\u0c97\u0cc6',shelterBedrockDesc:'\u0ca8\u0ca6\u0cbf \u0cae\u0c9f\u0ccd\u0c9f\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 240 \u0cae\u0cc0\u0c9f\u0cb0\u0ccd \u0c8e\u0ca4\u0ccd\u0ca4\u0cb0\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c97\u0c9f\u0ccd\u0c9f\u0cbf \u0cac\u0c82\u0ca1\u0cc6\u0caf \u0cae\u0cc7\u0cb2\u0cc6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cae\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0c95\u0cbe\u0c82\u0c95\u0ccd\u0cb0\u0cc0\u0c9f\u0ccd \u0cad\u0cb5\u0ca8. \u0cb8\u0ccc\u0cb0 \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cc1\u0ca4\u0ccd, \u0c95\u0cc1\u0ca1\u0cbf\u0caf\u0cc1\u0cb5 \u0ca8\u0cc0\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca5\u0cae \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6.',alternativeShelters:'\u0c87\u0ca4\u0cb0 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0ca4\u0cbe\u0ca3\u0c97\u0cb3\u0cc1',govtCollege:'\u0cb8\u0cb0\u0ccd\u0c95\u0cbe\u0cb0\u0cbf \u0caa\u0ca6\u0cb5\u0cbf\u0caa\u0cc2\u0cb0\u0ccd\u0cb5 \u0c95\u0cbe\u0cb2\u0cc7\u0c9c\u0cc1',panchayatBhawan:'\u0caa\u0c82\u0c9a\u0cbe\u0caf\u0ca4\u0ccd \u0cad\u0cb5\u0ca8',primarySchool:'\u0caa\u0ccd\u0cb0\u0cbe\u0ca5\u0cae\u0cbf\u0c95 \u0cb6\u0cbe\u0cb2\u0cc6',highRidge:'\u0cb9\u0cc8 \u0cb0\u0cbf\u0ca1\u0ccd\u0c9c\u0ccd \u0cae\u0cc8\u0ca6\u0cbe\u0ca8',startNavigation:'\u0c8e\u0ca4\u0ccd\u0ca4\u0cb0\u0ca6 \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0c86\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf',uphillDirections:'\u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u203a',shelterWalkTime:'\u0cb8\u0cae\u0cc1\u0ca6\u0cbe\u0caf \u0cad\u0cb5\u0ca8 \xb7 ~15 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7 \u0c8e\u0ca4\u0ccd\u0ca4\u0cb0\u0ca6 \u0ca8\u0ca1\u0cbf\u0c97\u0cc6',liveSummary:'\u0cb2\u0cc8\u0cb5\u0ccd \u0cb0\u0cc7\u0ca1\u0cbe\u0cb0\u0ccd \u0cb8\u0cbe\u0cb0\u0cbe\u0c82\u0cb6',currentStatus:'\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0c85\u0caa\u0cbe\u0caf\u0ca6 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf',normalSafe:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 / \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf',waterLevelLabel:'\u0ca8\u0ca6\u0cbf \u0ca8\u0cc0\u0cb0\u0cbf\u0ca8 \u0cae\u0c9f\u0ccd\u0c9f',waterLevelVal:'1,150.2 \u0cae\u0cc0 (\u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf)',evacLeadTimeLabel:'\u0cb8\u0ccd\u0ca5\u0cb3\u0cbe\u0c82\u0ca4\u0cb0 \u0c95\u0cbe\u0cb2\u0cbe\u0cb5\u0c95\u0cbe\u0cb6',evacLeadTimeVal:'35 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7 \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0ca6\u0cc6',dispatchSosBtn:'\u0c8e\u0ca8\u0ccd\u200c\u0ca1\u0cbf\u0c86\u0cb0\u0ccd\u200c\u0c8e\u0cab\u0ccd \u0cb0\u0c95\u0ccd\u0cb7\u0ca3\u0cbe \u0ca4\u0c82\u0ca1\u0c95\u0ccd\u0c95\u0cc6 SOS \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf',dialectNameNotice:'\u0c95\u0cca\u0ca1\u0c97\u0cc1 / \u0c9a\u0cbf\u0c95\u0ccd\u0c95\u0cae\u0c97\u0cb3\u0cc2\u0cb0\u0cc1 \u0cae\u0cb2\u0cc6\u0ca8\u0cbe\u0ca1\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf'},mr:{appName:'\u0913\u0930\u093e\u092e\u0947\u091f (OraMet)',appSubtitle:'\u092b\u094d\u0932\u0945\u0936 \u092a\u0942\u0930 \u0906\u0923\u093f \u0926\u0930\u0921 \u0915\u094b\u0938\u0933\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u0942\u0930\u094d\u0935\u0938\u0942\u091a\u0928\u093e',liveWatchHeader:'\u0925\u0947\u091f \u092a\u0942\u0930 \u0906\u0923\u093f \u0939\u0935\u093e\u